{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "curl -sSL https://dot.net/v1/dotnet-install.sh -o dotnet-install.sh && bash dotnet-install.sh --channel 10.0 --install-dir ./.dotnet",
  "buildCommand": "./.dotnet/dotnet publish src/AutoBrillo.Web/AutoBrillo.Web.csproj -c Release -o publicado",
  "outputDirectory": "publicado/wwwroot",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
