@page "/comisiones"
@inherits PaginaOperativa
<PageTitle>Comisiones | AutoBrillo</PageTitle>
@if(cargando){<p>Comprobando sesión...</p>}else if(!string.IsNullOrWhiteSpace(mensajeAcceso)){<p role="alert">@mensajeAcceso</p>}else{<div class="panel-abm"><p class="etiqueta">ADMINISTRACIÓN</p><h1>Comisiones</h1><p>Porcentaje global aplicado a los servicios y adicionales de las ventas nuevas, con reparto igual entre los funcionarios participantes.</p><div class="grilla-campos"><div class="campo-abm"><label>Porcentaje (%)</label><input type="number" min="0" max="100" step="0.01" @bind="porcentaje" /></div></div><div class="acciones-formulario"><button @onclick="Guardar">Guardar porcentaje</button></div><h2>Historial</h2><div class="tabla-contenedor"><table><thead><tr><th>Venta</th><th>Funcionario</th><th>Porcentaje aplicado</th><th>Importe</th><th>Estado</th></tr></thead><tbody>@foreach(var c in comisiones){<tr><td>#@c.Id_Ventas</td><td>@c.Funcionario</td><td>@c.PorcentajeAplicado %</td><td>@Gs(c.Importe)</td><td>@(c.Anulada?"Anulada":"Vigente")</td></tr>}</tbody></table></div></div>}
