@page "/productos"
@inject ServicioAutenticacion Autenticacion
@inject ServicioGestion Gestion
@inject ServicioAlertas Alertas
@inject NavigationManager Navegacion

<PageTitle>Productos | AutoBrillo</PageTitle>

@if (cargando)
{
    <p>Comprobando tu sesión...</p>
}
@if (!cargando)
{
    <div class="panel-abm">
        <h1>Productos y servicios</h1>
        <p>Registrá productos, insumos y servicios con sus precios y stock.</p>

        <div class="formulario-abm formulario-abm-vertical">
            <div class="campo-abm">
                <label for="producto-descripcion">Descripción</label>
                <input id="producto-descripcion" @bind="edicion.Descripcion" placeholder="Ej.: Lavado completo" maxlength="150" />
            </div>
            <div class="campo-abm">
                <label for="producto-costo">Precio de costo</label>
                <input id="producto-costo" @bind="edicion.PrecioDeCosto" type="number" min="0" step="1" inputmode="numeric" placeholder="0" />
            </div>
            <div class="campo-abm">
                <label for="producto-venta">Precio de venta</label>
                <input id="producto-venta" @bind="edicion.PrecioDeVenta" type="number" min="0" step="1" inputmode="numeric" placeholder="0" />
            </div>
            <div class="campo-abm">
                <label for="producto-stock">@(edicion.Id_Productos == 0 ? "Stock inicial" : "Stock actual")</label>
                <input id="producto-stock" @bind="edicion.StockActual" type="number" min="0" step="1" inputmode="numeric" placeholder="0" disabled="@(edicion.Id_Productos != 0)" />
                @if (edicion.Id_Productos != 0)
                {
                    <small>El stock se actualiza con compras, ventas o ajustes de inventario.</small>
                }
            </div>
        </div>

        <div class="campo-abm selector-tipos">
            <label id="etiqueta-tipos-producto">Tipos de producto</label>
            <div class="lista-checks" role="group" aria-labelledby="etiqueta-tipos-producto">
                @foreach (var tipo in tipos)
                {
                    var idTipo = tipo.Id_Tipos_Productos;
                    var seleccionado = TipoSeleccionado(idTipo);
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="@($"tipo-producto-{idTipo}")" checked="@seleccionado" @onchange="() => CambiarTipo(idTipo)" />
                        <label class="form-check-label" for="@($"tipo-producto-{idTipo}")">@tipo.Descripcion</label>
                    </div>
                }
            </div>
            <small>Podés seleccionar uno o varios tipos.</small>
        </div>

        <div class="acciones-formulario">
            <button type="button" class="btn btn-primary" @onclick="GuardarProducto">@(edicion.Id_Productos == 0 ? "Agregar producto" : "Guardar cambios")</button>
            @if (edicion.Id_Productos != 0)
            {
                <button type="button" class="btn btn-outline-secondary" @onclick="() => edicion = new()">Cancelar</button>
            }
        </div>

        <TablaDatos Id="tabla-productos" Datos="productos">
                <thead>
                    <tr><th>Id</th><th>Descripción</th><th>Costo</th><th>Venta</th><th>Stock</th><th>Tipos</th><th>Estado</th><th class="acciones-tabla">Acciones</th></tr>
                </thead>
                <tbody>
                    @foreach (var producto in productos)
                    {
                        <tr>
                            <td>@producto.Id_Productos</td>
                            <td>@producto.Descripcion</td>
                            <td data-order="@producto.PrecioDeCosto.ToString(System.Globalization.CultureInfo.InvariantCulture)">@producto.PrecioDeCosto.ToString("N0")</td>
                            <td data-order="@producto.PrecioDeVenta.ToString(System.Globalization.CultureInfo.InvariantCulture)">@producto.PrecioDeVenta.ToString("N0")</td>
                            <td data-order="@producto.StockActual.ToString(System.Globalization.CultureInfo.InvariantCulture)">@producto.StockActual.ToString("N0")</td>
                            <td>@string.Join(", ", producto.Tipos)</td>
                            <td>@(producto.Activo ? "Activo" : "Desactivado")</td>
                            <td class="acciones-tabla">
                                <div class="btn-group btn-group-sm" role="group">
                                    <button type="button" class="btn btn-sm @(producto.Activo ? "btn-outline-warning" : "btn-outline-success")" @onclick="() => CambiarEstado(producto)" title="@(producto.Activo ? "Desactivar" : "Activar")" aria-label="@(producto.Activo ? "Desactivar producto" : "Activar producto")"><i class="bi @(producto.Activo ? "bi-slash-circle" : "bi-check-lg")" aria-hidden="true"></i></button>
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => EditarProducto(producto)" title="Editar" aria-label="Editar producto"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => EliminarProducto(producto)" title="Eliminar" aria-label="Eliminar producto"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
        </TablaDatos>
    </div>

    <div class="panel-abm" style="margin-top:1rem">
        <h2>Tipos de producto</h2>
        <div class="formulario-abm">
            <input @bind="tipoEdicion.Descripcion" placeholder="Ej.: Servicio" maxlength="100" />
            <button type="button" class="btn btn-primary" @onclick="GuardarTipo">@(tipoEdicion.Id_Tipos_Productos == 0 ? "Agregar tipo" : "Guardar tipo")</button>
            @if (tipoEdicion.Id_Tipos_Productos != 0)
            {
                <button type="button" class="btn btn-outline-secondary" @onclick="() => tipoEdicion = new()">Cancelar</button>
            }
        </div>
        <TablaDatos Id="tabla-tipos-productos" Datos="tipos">
            <thead><tr><th>Id</th><th>Descripción</th><th class="acciones-tabla">Acciones</th></tr></thead>
            <tbody>
                @foreach (var tipo in tipos)
                {
                    <tr>
                        <td>@tipo.Id_Tipos_Productos</td>
                        <td>@tipo.Descripcion</td>
                        <td class="acciones-tabla">
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => EditarTipo(tipo)" title="Editar" aria-label="Editar tipo de producto"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => EliminarTipo(tipo)" title="Eliminar" aria-label="Eliminar tipo de producto"><i class="bi bi-trash" aria-hidden="true"></i></button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </TablaDatos>
    </div>
}
