@page "/usuarios"
@inject ServicioAutenticacion Autenticacion
@inject ServicioGestion Gestion
@inject ServicioAlertas Alertas
@inject NavigationManager Navegacion

<PageTitle>Usuarios | AutoBrillo</PageTitle>

@if (cargando)
{
    <p>Comprobando tu sesión...</p>
}
@if (!cargando)
{
    <div class="panel-abm panel-usuarios">
        <header class="encabezado-abm">
            <div>
                <p class="etiqueta">ADMINISTRACIÓN</p>
                <h1>Usuarios y accesos</h1>
                <p>Creá usuarios, asigná o modificá sus roles y, si corresponde, vinculá la cuenta a un cliente, funcionario o proveedor.</p>
            </div>
            <div class="insignia-acceso" aria-hidden="true">◈</div>
        </header>

        <div class="formulario-usuario">
            <div class="campo-usuario">
                <label for="nombre-usuario">Nombre de usuario</label>
                <input id="nombre-usuario" @bind="edicion.Nombre" placeholder="Ej.: María González" maxlength="100" />
            </div>
            <div class="campo-usuario campo-password">
                <label for="password-usuario">@(edicion.Id_Usuarios == 0 ? "Contraseña" : "Nueva contraseña (opcional)")</label>
                <div class="entrada-con-accion">
                    <input id="password-usuario" @bind="edicion.Password" type="@(mostrarPasswords ? "text" : "password")" placeholder="Mínimo 6 caracteres" />
                    <button type="button" class="alternar-password" @onclick="() => mostrarPasswords = !mostrarPasswords" aria-label="@(mostrarPasswords ? "Ocultar contraseñas" : "Ver contraseñas")" title="@(mostrarPasswords ? "Ocultar contraseñas" : "Ver contraseñas")" aria-pressed="@mostrarPasswords">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z" />
                            <circle cx="12" cy="12" r="2.5" />
                            @if (mostrarPasswords)
                            {
                                <path d="M4 4l16 16" />
                            }
                        </svg>
                        <span class="lector-pantalla">@(mostrarPasswords ? "Ocultar contraseñas" : "Ver contraseñas")</span>
                    </button>
                </div>
            </div>
            <div class="campo-usuario campo-password">
                <label for="confirmar-password-usuario">Confirmar contraseña</label>
                <div class="entrada-con-accion">
                    <input id="confirmar-password-usuario" @bind="confirmacionPassword" type="@(mostrarPasswords ? "text" : "password")" placeholder="Repetí la contraseña" />
                    <button type="button" class="alternar-password" @onclick="() => mostrarPasswords = !mostrarPasswords" aria-label="@(mostrarPasswords ? "Ocultar contraseñas" : "Ver contraseñas")" title="@(mostrarPasswords ? "Ocultar contraseñas" : "Ver contraseñas")" aria-pressed="@mostrarPasswords">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z" />
                            <circle cx="12" cy="12" r="2.5" />
                            @if (mostrarPasswords)
                            {
                                <path d="M4 4l16 16" />
                            }
                        </svg>
                        <span class="lector-pantalla">@(mostrarPasswords ? "Ocultar contraseñas" : "Ver contraseñas")</span>
                    </button>
                </div>
            </div>
            <div class="campo-usuario">
                <label for="persona-usuario">Persona vinculada (opcional)</label>
                <select id="persona-usuario" @bind="idPersona">
                    <option value="0">Sin persona vinculada</option>
                    @foreach (var persona in personas)
                    {
                        <option value="@persona.Id_Personas">@persona.Nombre (@string.Join(", ", persona.Tipos))</option>
                    }
                </select>
            </div>
        </div>

        <div class="acceso-roles" aria-labelledby="titulo-roles">
            <div class="encabezado-roles">
                <div>
                    <p class="etiqueta">ROL Y ACCESO</p>
                    <h2 id="titulo-roles">Elegí los roles del usuario</h2>
                    <p>Marcá uno o más roles según las tareas que realizará.</p>
                </div>
                <span class="contador-roles">@edicion.Id_Roles.Count seleccionado@(edicion.Id_Roles.Count == 1 ? "" : "s")</span>
            </div>
            <div class="grilla-roles">
                @foreach (var rol in roles)
                {
                    var seleccionado = EstaSeleccionado(rol.Id_Roles);
                    <label class="tarjeta-rol @(seleccionado ? "rol-seleccionado" : "")">
                        <input type="checkbox" checked="@seleccionado" @onchange="() => CambiarRol(rol.Id_Roles)" />
                        <span class="marca-rol" aria-hidden="true">@rol.Descripcion[..1].ToUpper()</span>
                        <span class="detalle-rol">
                            <small>ROL</small>
                            <strong>@rol.Descripcion</strong>
                        </span>
                        <span class="estado-rol" aria-hidden="true">✓</span>
                    </label>
                }
            </div>
        </div>

        <div class="acciones-formulario">
            <button type="button" class="btn btn-primary" @onclick="Guardar">@(edicion.Id_Usuarios == 0 ? "Crear usuario" : "Guardar cambios")</button>
            @if (edicion.Id_Usuarios != 0)
            {
                <button type="button" class="btn btn-outline-secondary" @onclick="Cancelar">Cancelar edición</button>
            }
        </div>

        <TablaDatos Id="tabla-usuarios" Datos="usuarios">
                <thead><tr><th>Id</th><th>Usuario</th><th>Persona</th><th>Roles asignados</th><th>Estado</th><th class="acciones-tabla">Acciones</th></tr></thead>
                <tbody>
                    @foreach (var usuario in usuarios)
                    {
                        <tr>
                            <td>@usuario.Id_Usuarios</td>
                            <td>@usuario.Nombre</td>
                            <td>@(string.IsNullOrWhiteSpace(usuario.Persona) ? "—" : usuario.Persona)</td>
                            <td>@string.Join(", ", usuario.Roles)</td>
                            <td>@(usuario.Activo ? "Activo" : "Desactivado")</td>
                            <td class="acciones-tabla">
                                <div class="btn-group btn-group-sm" role="group">
                                    <button type="button" class="btn btn-sm @(usuario.Activo ? "btn-outline-warning" : "btn-outline-success")" @onclick="() => CambiarEstado(usuario)" aria-label="@(usuario.Activo ? "Desactivar usuario" : "Activar usuario")" title="@(usuario.Activo ? "Desactivar usuario" : "Activar usuario")">
                                        <i class="bi @(usuario.Activo ? "bi-slash-circle" : "bi-check-lg")" aria-hidden="true"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => Editar(usuario)" aria-label="Editar usuario" title="Editar usuario">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                    </button>
                                    @if (usuario.Id_Usuarios != idSesion)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => Eliminar(usuario)" aria-label="Eliminar usuario" title="Eliminar usuario">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
        </TablaDatos>
    </div>
}
