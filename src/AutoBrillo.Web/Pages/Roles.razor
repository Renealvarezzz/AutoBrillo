@page "/roles"
@inject ServicioAutenticacion Autenticacion
@inject ServicioGestion Gestion
@inject ServicioAlertas Alertas
@inject NavigationManager Navegacion

<PageTitle>Roles | AutoBrillo</PageTitle>

@if (cargando)
{
    <p>Comprobando tu sesión...</p>
}
@if (!cargando)
{
    <div class="panel-abm">
        <h1>ABM de Roles</h1>
        <p>Creá, editá o eliminá los roles disponibles para los usuarios.</p>
        <div class="formulario-abm">
            <input @bind="edicion.Descripcion" placeholder="Descripción del rol" maxlength="100" />
            <button type="button" class="btn btn-primary" @onclick="Guardar">@(edicion.Id_Roles == 0 ? "Agregar rol" : "Guardar cambios")</button>
            @if (edicion.Id_Roles != 0)
            {
                <button type="button" class="btn btn-outline-secondary" @onclick="Cancelar">Cancelar</button>
            }
        </div>
        <TablaDatos Id="tabla-roles" Datos="roles">
            <thead><tr><th>Id</th><th>Descripción</th><th class="acciones-tabla">Acciones</th></tr></thead>
            <tbody>
                @foreach (var rol in roles)
                {
                    <tr>
                        <td>@rol.Id_Roles</td>
                        <td>@rol.Descripcion</td>
                        <td class="acciones-tabla">
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => Editar(rol)" aria-label="Editar rol" title="Editar rol">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => Eliminar(rol)" aria-label="Eliminar rol" title="Eliminar rol">
                                    <i class="bi bi-trash" aria-hidden="true"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </TablaDatos>
    </div>
}
