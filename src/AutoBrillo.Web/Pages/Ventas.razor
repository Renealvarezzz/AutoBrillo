@page "/ventas"
@inherits PaginaSprintTres
<PageTitle>Ventas | AutoBrillo</PageTitle>
@if(cargando){<p>Comprobando sesión...</p>}
else if(!string.IsNullOrWhiteSpace(mensajeAcceso)){<p role="alert">@mensajeAcceso</p>}
else{<div class="panel-abm"><p class="etiqueta">OPERACIONES</p><h1>Ventas</h1>
<div class="grilla-campos"><div class="campo-abm"><label>Lavado asociado (opcional)</label><select value="@idLavado" @onchange="CambiarLavado"><option value="0">Sin asociación</option>@foreach(var l in lavados.Where(LavadoDisponibleParaVenta)){<option value="@l.Id_Lavados">#@l.Id_Lavados · @l.Vehiculo · sector @l.Sector · @l.Estado</option>}</select></div>
<div class="campo-abm"><label>Condición</label><select @bind="condicion"><option>Contado</option><option>Crédito</option></select></div>
<div class="campo-abm"><label>Producto / servicio</label><select @bind="producto"><option value="0">Seleccionar...</option>@foreach(var p in productos.Where(x=>x.Activo)){<option value="@p.Id_Productos">@p.Descripcion · @Gs(p.PrecioDeVenta)</option>}</select></div>
<div class="campo-abm"><label>Cantidad</label><input type="number" min="1" step="1" @bind="cantidad" /></div></div><div class="acciones-formulario"><button type="button" class="btn btn-outline-primary text-nowrap" @onclick="Agregar"><i class="bi bi-plus-lg" aria-hidden="true"></i> Agregar línea</button><button type="button" class="btn btn-primary" @onclick="Registrar">Registrar venta</button></div>
@if(lineas.Count>0){<p>@string.Join(" · ",lineas.Select(x=>$"{x.Cantidad} × {productos.FirstOrDefault(p=>p.Id_Productos==x.Id_Productos)?.Descripcion}"))</p>}
<h2>Ventas y cobros</h2><TablaDatos Id="tabla-ventas" Datos="ventas"><thead><tr><th>#</th><th>Fecha</th><th>Lavado</th><th>Condición</th><th>Total</th><th>Cobrado</th><th>Estado</th><th>Cobro</th><th class="acciones-tabla">Acciones</th></tr></thead><tbody>@foreach(var v in ventas){<tr><td>@v.Id_Ventas</td><td data-order="@v.Fecha.ToString("yyyyMMddHHmmss")">@Fecha(v.Fecha)</td><td>@v.Id_Lavados</td><td>@v.Condicion</td><td data-order="@v.Total.ToString(System.Globalization.CultureInfo.InvariantCulture)">@Gs(v.Total)</td><td data-order="@v.Cobrado.ToString(System.Globalization.CultureInfo.InvariantCulture)">@Gs(v.Cobrado)</td><td>@v.Estado</td><td>@if(v.Estado=="Registrada"&&v.Total>v.Cobrado){<select value="@Medio(v.Id_Ventas)" @onchange="e => FijarMedio(v.Id_Ventas, e)"><option>Efectivo</option><option>Débito</option><option>Crédito</option></select><input type="number" min="1" step="1" value="@Importe(v.Id_Ventas)" @onchange="e => FijarImporte(v.Id_Ventas, e)" /><button type="button" class="btn btn-sm btn-success text-nowrap" @onclick="()=>Cobrar(v)"><i class="bi bi-cash" aria-hidden="true"></i> Cobrar</button>}</td><td class="acciones-tabla">@if(esAdministrador&&v.Estado=="Registrada"){<div class="btn-group btn-group-sm" role="group"><button type="button" class="btn btn-sm btn-outline-danger" title="Anular" aria-label="Anular venta" @onclick="()=>Anular(v)"><i class="bi bi-x-circle" aria-hidden="true"></i></button></div>}</td></tr>}</tbody></TablaDatos></div>}
