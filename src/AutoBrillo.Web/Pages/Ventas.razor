@page "/ventas"
@inherits PaginaSprintTres
<PageTitle>Ventas | AutoBrillo</PageTitle>
@if(cargando){<p>Comprobando sesión...</p>}else{<div class="panel-abm"><p class="etiqueta">OPERACIONES</p><h1>Ventas</h1>
<div class="grilla-campos"><div class="campo-abm"><label>Lavado asociado (opcional)</label><select @bind="idLavado"><option value="0">Sin asociación</option>@foreach(var l in lavados.Where(x=>x.Estado=="Registrado")){<option value="@l.Id_Lavados">#@l.Id_Lavados · @l.Vehiculo · sector @l.Sector</option>}</select></div>
<div class="campo-abm"><label>Condición</label><select @bind="condicion"><option>Contado</option><option>Crédito</option></select></div>
<div class="campo-abm"><label>Producto / servicio</label><select @bind="producto"><option value="0">Seleccionar...</option>@foreach(var p in productos.Where(x=>x.Activo)){<option value="@p.Id_Productos">@p.Descripcion · @Gs(p.PrecioDeVenta)</option>}</select></div>
<div class="campo-abm"><label>Cantidad</label><input type="number" min="1" step="1" @bind="cantidad" /></div></div><div class="acciones-formulario"><button @onclick="Agregar">Agregar línea</button><button @onclick="Registrar">Registrar venta</button></div>
@if(lineas.Count>0){<p>@string.Join(" · ",lineas.Select(x=>$"{x.Cantidad} × {productos.FirstOrDefault(p=>p.Id_Productos==x.Id_Productos)?.Descripcion}"))</p>}
<h2>Ventas y cobros</h2><div class="tabla-contenedor"><table><thead><tr><th>#</th><th>Fecha</th><th>Lavado</th><th>Condición</th><th>Total</th><th>Cobrado</th><th>Estado</th><th>Cobro</th><th></th></tr></thead><tbody>@foreach(var v in ventas){<tr><td>@v.Id_Ventas</td><td>@Fecha(v.Fecha)</td><td>@v.Id_Lavados</td><td>@v.Condicion</td><td>@Gs(v.Total)</td><td>@Gs(v.Cobrado)</td><td>@v.Estado</td><td>@if(v.Estado=="Registrada"&&v.Total>v.Cobrado){<select @bind="medio"><option>Efectivo</option><option>Débito</option><option>Crédito</option></select><input type="number" min="1" step="1" @bind="importeCobro"/><button @onclick="()=>Cobrar(v)">Cobrar</button>}</td><td>@if(esAdministrador&&v.Estado=="Registrada"){<button class="peligro" @onclick="()=>Anular(v)">Anular</button>}</td></tr>}</tbody></table></div></div>}
