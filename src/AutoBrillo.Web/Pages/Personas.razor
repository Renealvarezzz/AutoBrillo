@page "/personas"
@inject ServicioAutenticacion Autenticacion
@inject ServicioGestion Gestion
@inject ServicioAlertas Alertas
@inject NavigationManager Navegacion

<PageTitle>Personas | AutoBrillo</PageTitle>

@if (cargando)
{
    <p>Comprobando tu sesión...</p>
}
@if (!cargando)
{
    <div class="panel-abm">
        <h1>Personas</h1>
        <p>Administrá clientes, funcionarios y proveedores desde una sola ficha. La cuenta de usuario es opcional y se vincula en Usuarios. Los vehículos del cliente se cargan en Vehículos.</p>

        <div class="formulario-abm formulario-abm-vertical">
            <div class="campo-abm">
                <label for="persona-nombre">Nombre completo</label>
                <input id="persona-nombre" @bind="edicion.Nombre" placeholder="Ej.: Ana Gómez" maxlength="150" />
            </div>
            <div class="campo-abm">
                <label for="persona-documento">Documento</label>
                <input id="persona-documento" @bind="edicion.Documento" placeholder="Número de documento" maxlength="50" />
            </div>
            <div class="campo-abm">
                <label for="persona-telefono">Teléfono</label>
                <input id="persona-telefono" @bind="edicion.Telefono" placeholder="Número de teléfono" maxlength="30" inputmode="tel" />
            </div>
        </div>

        <div class="campo-abm selector-tipos">
            <label id="etiqueta-tipos-persona">Tipos de persona</label>
            <div class="lista-checks" role="group" aria-labelledby="etiqueta-tipos-persona">
                @foreach (var tipo in tipos)
                {
                    var idTipo = tipo.Id_Tipos_Personas;
                    var seleccionado = TipoSeleccionado(idTipo);
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="@($"tipo-persona-{idTipo}")" checked="@seleccionado" @onchange="() => CambiarTipo(idTipo)" />
                        <label class="form-check-label" for="@($"tipo-persona-{idTipo}")">@tipo.Descripcion</label>
                    </div>
                }
            </div>
            <small>Podés seleccionar uno o varios tipos.</small>
        </div>

        <div class="acciones-formulario">
            <button type="button" class="btn btn-primary" @onclick="GuardarPersona">@(edicion.Id_Personas == 0 ? "Agregar persona" : "Guardar cambios")</button>
            @if (edicion.Id_Personas != 0)
            {
                <button type="button" class="btn btn-outline-secondary" @onclick="CancelarPersona">Cancelar</button>
            }
        </div>

        <TablaDatos Id="tabla-personas" Datos="personas">
                <thead><tr><th>Id</th><th>Nombre</th><th>Documento</th><th>Teléfono</th><th>Tipos</th><th>Estado</th><th class="acciones-tabla">Acciones</th></tr></thead>
                <tbody>
                    @foreach (var persona in personas)
                    {
                        <tr>
                            <td>@persona.Id_Personas</td>
                            <td>@persona.Nombre</td>
                            <td>@persona.Documento</td>
                            <td>@persona.Telefono</td>
                            <td>@string.Join(", ", persona.Tipos)</td>
                            <td>@(persona.Activo ? "Activo" : "Desactivado")</td>
                            <td class="acciones-tabla">
                                <div class="btn-group btn-group-sm" role="group">
                                    <button type="button" class="btn btn-sm @(persona.Activo ? "btn-outline-warning" : "btn-outline-success")" @onclick="() => CambiarEstado(persona)" title="@(persona.Activo ? "Desactivar" : "Activar")" aria-label="@(persona.Activo ? "Desactivar persona" : "Activar persona")"><i class="bi @(persona.Activo ? "bi-slash-circle" : "bi-check-lg")" aria-hidden="true"></i></button>
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => EditarPersona(persona)" title="Editar" aria-label="Editar persona"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => EliminarPersona(persona)" title="Eliminar" aria-label="Eliminar persona"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
        </TablaDatos>
    </div>

    <div class="panel-abm" style="margin-top:1rem">
        <h2>Tipos de persona</h2>
        <div class="formulario-abm">
            <input @bind="tipoEdicion.Descripcion" placeholder="Ej.: Cliente" maxlength="100" />
            <button type="button" class="btn btn-primary" @onclick="GuardarTipo">@(tipoEdicion.Id_Tipos_Personas == 0 ? "Agregar tipo" : "Guardar tipo")</button>
            @if (tipoEdicion.Id_Tipos_Personas != 0)
            {
                <button type="button" class="btn btn-outline-secondary" @onclick="() => tipoEdicion = new()">Cancelar</button>
            }
        </div>
        <TablaDatos Id="tabla-tipos-personas" Datos="tipos">
            <thead><tr><th>Id</th><th>Descripción</th><th class="acciones-tabla">Acciones</th></tr></thead>
            <tbody>
                @foreach (var tipo in tipos)
                {
                    <tr>
                        <td>@tipo.Id_Tipos_Personas</td>
                        <td>@tipo.Descripcion</td>
                        <td class="acciones-tabla">
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => EditarTipo(tipo)" title="Editar" aria-label="Editar tipo de persona"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => EliminarTipo(tipo)" title="Eliminar" aria-label="Eliminar tipo de persona"><i class="bi bi-trash" aria-hidden="true"></i></button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </TablaDatos>
    </div>
}
