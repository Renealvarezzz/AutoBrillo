# Plantilla para /opt/autobrillo/.env.production en el VPS.
# Copiar este archivo y reemplazar los valores. No subir secretos ni la cadena completa real.
# La API lee estos nombres en src/AutoBrillo.Api/Program.cs.

# Session pooler de Supabase (IPv4), puerto 5432.
# El host directo de la base es solo IPv6 y el VPS no lo alcanza.
# El usuario del pooler suele ser postgres.<ref-del-proyecto>.
CONNECTION_STRING=Host=aws-1-sa-east-1.pooler.supabase.com;Port=5432;Database=postgres;Username=REEMPLAZAR_USUARIO;Password=REEMPLAZAR_CONTRASEÑA;SSL Mode=Require

JWT_SECRET=REEMPLAZAR_CLAVE_LARGA_PRIVADA
JWT_ISSUER=AutoBrillo.Api
JWT_AUDIENCE=AutoBrillo.Web

# Origen exacto de la web. Sin barra final.
WEB_ORIGIN=https://autobrillo-lemon.vercel.app

# Puerto interno del contenedor. Caddy apunta a 127.0.0.1:8080.
PORT=8080
